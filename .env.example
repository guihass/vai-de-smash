# Copie este arquivo para `.env` e ajuste os valores.
# Apenas variáveis com prefixo VITE_ são expostas ao front-end.

# URL pública do site (usada em canonical, Open Graph e sitemap)
VITE_SITE_URL=https://vaidesmash.com.br

# Dados do negócio (sobrescrevem os valores padrão em src/data/business.js)
VITE_WHATSAPP_NUMBER=5519989061037
VITE_INSTAGRAM_URL=https://instagram.com/vai_de_smash
VITE_MENU_URL=https://app.cardapioweb.com/vaide_smash

# Base path do site. Use "/" para domínio próprio (Vercel/Netlify)
# ou "/nome-do-repo/" para GitHub Pages sem domínio customizado.
VITE_BASE_PATH=/

# Google Analytics 4 (opcional — deixe vazio para desativar)
VITE_GA_ID=
